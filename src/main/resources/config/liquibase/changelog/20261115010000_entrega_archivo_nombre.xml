<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!-- Liquibase 5.0.3 traduce blob a OID en PostgreSQL. Preservar el contenido de los large objects. -->
    <changeSet id="20261115010000-2" author="sgpg" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">SELECT count(*) FROM information_schema.columns
                WHERE table_schema = current_schema() AND table_name = 'entrega'
                AND column_name = 'archivo' AND data_type = 'oid'</sqlCheck>
        </preConditions>
        <sql>ALTER TABLE entrega ALTER COLUMN archivo TYPE bytea USING lo_get(archivo)</sql>
    </changeSet>
    <changeSet id="20261115010000-1" author="sgpg">
        <addColumn tableName="entrega">
            <column name="archivo_nombre" type="varchar(255)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
